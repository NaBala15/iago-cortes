// ==========================================================================
// Configuração do Worker do site do Iago Cortes
//
// O site é estático (index.html + style.css + script.js + fotos). O Worker
// serve esses arquivos e, antes de entregar a PÁGINA, pergunta ao banco do
// painel se este site está no ar — é o mesmo porteiro da JKM Calhas.
//
// NO CLOUDFLARE, o Worker que usa este arquivo precisa ter:
//   - nome exatamente igual ao "name" abaixo
//   - diretório raiz VAZIO (o repositório inteiro é a raiz do site)
//   - comando de implantação "npx wrangler deploy"
//
// Se o nome não bater com um Worker que já existe, a publicação cria um
// Worker NOVO e o site continua sendo servido pelo antigo.
// ==========================================================================
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iago-cortes",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./",
    "binding": "ASSETS",

    // Num Worker com arquivos estáticos o Cloudflare entrega o ARQUIVO antes
    // de rodar o Worker quando o endereço casa com um arquivo que existe.
    // Como "/" casa com o index.html, sem esta lista o porteiro nunca rodaria
    // na página. São só as PÁGINAS: uma execução por visita, não uma por foto.
    "run_worker_first": ["/", "/index.html"]
  },

  // O MESMO banco do painel, só para leitura. O painel escreve quando você
  // vira o interruptor da ficha; aqui o site só lê.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jeff-company-painel",
      "database_id": "43fb8fac-ca5c-4c0f-b7b1-96f3810428a7"
    }
  ],

  // Endereço .workers.dev não serve para site de cliente: só faria o site
  // aparecer duplicado na busca.
  "workers_dev": false,
  "preview_urls": false,

  "observability": { "enabled": true }
}
